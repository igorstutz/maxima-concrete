npm-debug.log*

# env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# Planilha do mapa: a coluna A tem o endereço COMPLETO dos clientes (com número
# da casa) e este repositório é público. Fica só na máquina de quem regenera os
# pinos (`npm run projects`); o resultado versionado, src/content/data/projects.json,
# só leva a rua sem número. O cache de geocodificação ao lado é versionado porque
# suas chaves são hashes — nenhum endereço legível.
_extraction/project-map.xlsx
_extraction/geocode-failures.txt

# dados brutos da extração (mantém scripts, ignora dumps pesados)
_extraction/site_content.json
_extraction/url-map.json
_extraction/image-urls.txt
_extraction/download-failures.txt
AJUSTES.md

# Assets brutos enviados pelo cliente (nao entram no site)
ajustes-assets/

# Variantes responsivas das imagens (derivadas). Geradas no build por
# _extraction/generate-image-variants.mjs; o manifesto em src/lib é versionado.
public/images/**/*-480w.webp
public/images/**/*-828w.webp
public/images/**/*-1280w.webp
public/images/**/*-1600w.webp
public/images/**/*-1920w.webp
# Recorte vertical do hero gerado a partir da imagem de desktop
public/images/**/*-mobilecrop.webp

# Documentos de ajustes enviados pelo cliente
Maxima Concrete - Ajustes*

# Dados de acesso ao servidor (hostinger.env) e qualquer outro arquivo local
# que não pode vazar — este repositório é público. Mesmo nome da pasta que o
# PHP usa no servidor, para não haver duas convenções na cabeça de ninguém.
/.private/
